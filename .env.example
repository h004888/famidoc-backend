# Sao chép thành .env và thay các giá trị mẫu trước khi chạy local.
# .env bị Git bỏ qua. Không commit mật khẩu/khóa thật.
PORT=4000
NODE_ENV=development

# Tính linh hoạt (Optional Flag):
# Nếu sau này bạn có máy chủ Staging / UAT hoặc có nhu cầu mở tạm Swagger có kiểm soát
# trên môi trường Production, bạn chỉ cần gán biến môi trường ENABLE_SWAGGER=true
# trong file .env của server đó mà không cần phải sửa code.
ENABLE_SWAGGER=false

# PostgreSQL lưu dữ liệu nghiệp vụ; Prisma là lớp truy vấn, không thay thế database.
# Mật khẩu ở hai dòng dưới phải giống nhau. Nên dùng chuỗi hex để tránh lỗi ký tự URL.
LOCAL_POSTGRES_PASSWORD=CHANGE_ME_TO_A_RANDOM_HEX_PASSWORD
DATABASE_URL=postgresql://famidoc:CHANGE_ME_TO_A_RANDOM_HEX_PASSWORD@127.0.0.1:55432/famidoc_dev?schema=public
# Redis riêng của FamiDoc; tránh trùng cổng 6379 của dự án khác.
REDIS_URL=redis://127.0.0.1:56379
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# disabled: tắt; simulation: thử local; sepay_test: webhook sandbox; live: nhận tiền thật sau khi cấu hình.
PAYMENTS_MODE=disabled
# Cấu hình tài khoản/ngân hàng TEST, không ghi tài khoản hoặc khóa thật vào Git.
PAYMENTS_EXPECTED_ACCOUNT=
PAYMENTS_EXPECTED_GATEWAY=
PAYMENT_REQUEST_TTL_MINUTES=15
# Secret của webhook SePay đang dùng, ít nhất 32 ký tự. Tách key riêng giữa TEST và LIVE.
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_AUTH=hmac
SEPAY_WEBHOOK_API_KEY=

# Cấu hình gửi OTP thật, bỏ trống thì API gửi mail trả 503 (không giả thành công).
SMTP_URL=
MAIL_FROM=
# Chỉ bật khi chủ động nạp fixture kiểm thử, không dùng cho seed production thật.
ALLOW_DEMO_SEED=0
DEMO_SEED_PASSWORD=

# ==============================================================================
# CẤU HÌNH MEDIA STACK (SeaweedFS S3 + imgproxy + Nginx Cache + Cloudflare SSL)
# ==============================================================================
# Domain xem ảnh công khai qua Cloudflare CDN + imgproxy
MEDIA_BASE_URL=https://media.famidoc.online

# Cặp khóa HMAC SHA-256 bí mật dùng để sinh chữ ký an toàn cho imgproxy
IMGPROXY_KEY=8b2a686c2e84ef19760c5262f4df645730bc340da3004ce5cb887d88fa2f06b0
IMGPROXY_SALT=70f30ffee1a6c378a8977eb2f141757590d59f512c90d7f6f903054e1b8c35fc

# Cấu hình kết nối SeaweedFS S3 Gateway
# - Local Dev & Ngoài Internet: dùng https://s3.famidoc.online
# - Backend chạy trong Docker Swarm trên VPS: có thể dùng http://media-storage:8333 hoặc https://s3.famidoc.online
S3_ENDPOINT=https://s3.famidoc.online
S3_BUCKET=photos
S3_ACCESS_KEY=AKIAFAMIDOCMEDIA2026
S3_SECRET_KEY=sec_famidoc_production_media_secret_key_98234
S3_REGION=us-east-1

