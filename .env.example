# File mẫu để đưa lên Git. Sao chép thành .env rồi điền cấu hình của bạn.

# Ứng dụng chạy trên máy. Biến từ Dokploy/shell vẫn được ưu tiên khi triển khai.
PORT="4000"
NODE_ENV="development"
ENABLE_SWAGGER="true"

# PostgreSQL đang dùng của nhóm; Redis local cho backend chạy trên máy.
DATABASE_URL="postgresql://famidoc:CHANGE_ME_LOCAL_PASSWORD@127.0.0.1:55432/famidoc_dev?schema=public"
REDIS_URL="redis://127.0.0.1:56379"
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"

# Mật khẩu PostgreSQL Docker local; chỉ compose.local.yml sử dụng.
LOCAL_POSTGRES_PASSWORD="CHANGE_ME_LOCAL_PASSWORD"

# Thanh toán local giữ chế độ simulation hiện có; cấu hình Live trên Dokploy là riêng.
PAYMENTS_MODE="simulation"
PAYMENTS_EXPECTED_ACCOUNT="0000000000"
PAYMENTS_EXPECTED_GATEWAY="TEST_BANK"
PAYMENT_REQUEST_TTL_MINUTES="15"
SEPAY_WEBHOOK_AUTH="hmac"
SEPAY_WEBHOOK_SECRET="CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS"
SEPAY_WEBHOOK_API_KEY=""

# SeaweedFS S3 theo hướng dẫn media stack của nhóm. Không phải MinIO mới.
S3_ENDPOINT="http://YOUR_S3_HOST:8333"
S3_BUCKET="photos"
S3_ACCESS_KEY="CHANGE_ME_S3_ACCESS_KEY"
S3_SECRET_KEY="CHANGE_ME_S3_SECRET_KEY"
S3_REGION="us-east-1"
MEDIA_BASE_URL="https://YOUR_MEDIA_DOMAIN"
IMGPROXY_KEY=""
IMGPROXY_SALT=""

# SMTP: điền tài khoản gửi mail thật để gửi OTP; chưa cấu hình thì để trống.
SMTP_URL=""
MAIL_FROM=""

# Seed chỉ chạy khi chủ động bật ALLOW_DEMO_SEED=1; không tự nạp dữ liệu khi bật backend.
ALLOW_DEMO_SEED="0"
DEMO_SEED_PASSWORD=""

# Chỉ npm run test:db sử dụng hai biến TEST_*; bắt buộc DB local riêng.
TEST_DATABASE_URL="postgresql://famidoc:CHANGE_ME_LOCAL_PASSWORD@127.0.0.1:55432/famidoc_billing_test?schema=public"
TEST_REDIS_URL="redis://127.0.0.1:56379/15"

# Bật trên VPS để tạo thông báo trước hạn hợp đồng 15 ngày.
CONTRACT_REMINDERS_ENABLED="false"
