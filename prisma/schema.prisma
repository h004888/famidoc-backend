model Invoice {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceCode     String        @unique @map("invoice_code") @db.VarChar(50)
  // Nội dung QR đã chốt, không đổi theo tên tài khoản sau khi phát hành hóa đơn.
  transferContent String?       @map("transfer_content") @db.VarChar(140)
  adminTransferDescription String? @map("admin_transfer_description") @db.VarChar(100)
  contractId      String?       @map("contract_id") @db.Uuid
  addendumId      String?       @map("addendum_id") @db.Uuid
  encounterId     String?       @map("encounter_id") @db.Uuid
  grossAmount     Decimal       @map("gross_amount") @db.Decimal(12, 2)
  vatAmount       Decimal       @default(0.00) @map("vat_amount") @db.Decimal(12, 2)
  totalPayable    Decimal       @map("total_payable") @db.Decimal(12, 2)
  paymentGateway  String        @default("VIETQR") @map("payment_gateway") @db.VarChar(50)
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  expiredAt       DateTime      @map("expired_at") @db.Timestamptz()
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Invoice là yêu cầu thanh toán; không tạo thêm bảng PaymentRequest song song.
  environment           String    @default("TEST") @db.VarChar(10)
  attempt               Int       @default(1)
  expectedAccountNumber String?   @map("expected_account_number") @db.VarChar(50)
  expectedGateway       String?   @map("expected_gateway") @db.VarChar(50)
  paidAt                DateTime? @map("paid_at") @db.Timestamptz()
  acceptedTransactionId String?   @unique @map("accepted_transaction_id") @db.Uuid

  // Relations
  contract            MedicalContract?     @relation(fields: [contractId], references: [id], onDelete: Restrict)
  addendum            ContractAddendum?    @relation(fields: [addendumId], references: [id], onDelete: Restrict)
  encounter           Encounter?           @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  paymentTransactions PaymentTransaction[] @relation("InvoiceTransactions")
  acceptedTransaction PaymentTransaction?  @relation("AcceptedInvoiceTransaction", fields: [acceptedTransactionId], references: [id], onDelete: Restrict)

  settlementItems FacilitySettlementItem[]

  @@map("invoices")
}

model SePayWebhookEvent {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environment           String   @db.VarChar(10)
  status                String   @db.VarChar(10)
  httpStatus            Int      @map("http_status")
  resultCode            String   @map("result_code") @db.VarChar(50)
  providerTransactionId String?  @map("provider_transaction_id") @db.VarChar(100)
  transactionId         String?  @map("transaction_id") @db.Uuid
  receivedAt            DateTime @default(now()) @map("received_at") @db.Timestamptz()

  @@index([environment, receivedAt(sort: Desc), id], map: "sepay_webhook_events_env_received_idx")
  @@index([environment, status, receivedAt(sort: Desc), id], map: "sepay_webhook_events_env_status_received_idx")
  @@map("sepay_webhook_events")
}

model PaymentTransaction {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Cho phép lưu cả giao dịch chưa ghép được hóa đơn để không mất dấu tiền đến.
  invoiceId            String?  @map("invoice_id") @db.Uuid
  gatewayTransactionId String   @map("gateway_transaction_id") @db.VarChar(100)
  amountReceived       Decimal  @map("amount_received") @db.Decimal(12, 2)
  paymentTime          DateTime @map("payment_time") @db.Timestamptz()
  signatureVerified    Boolean  @map("signature_verified")
  webhookPayload       Json     @map("webhook_payload") @db.JsonB
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz()

  environment      String  @default("TEST") @db.VarChar(10)
  fingerprint      String  @db.VarChar(64)
  bankReferenceKey String? @map("bank_reference_key") @db.Text
  gateway          String  @db.VarChar(100)
  accountNumber    String  @map("account_number") @db.VarChar(50)
  transferType     String  @map("transfer_type") @db.VarChar(10)
  paymentCode      String? @map("payment_code") @db.VarChar(50)
  referenceCode    String  @default("") @map("reference_code") @db.VarChar(150)
  outcome          String  @db.VarChar(30)
  reason           String? @db.VarChar(50)

  // Webhook dùng ID số cũ, API v2 dùng UUID. Giữ cả hai để cùng một giao dịch
  // không bị ghi hai lần khi webhook và job đối soát đến theo thứ tự bất kỳ.
  sepayWebhookTransactionId String?   @map("sepay_webhook_transaction_id") @db.VarChar(100)
  sepayApiTransactionId     String?   @map("sepay_api_transaction_id") @db.Uuid
  ingestionSource           String    @default("WEBHOOK") @map("ingestion_source") @db.VarChar(20)
  reconciledAt              DateTime? @map("reconciled_at") @db.Timestamptz()
  reconciliationRunId       String?   @map("reconciliation_run_id") @db.Uuid

  // Relations
  invoice           Invoice?                @relation("InvoiceTransactions", fields: [invoiceId], references: [id], onDelete: Restrict)
  acceptedBy        Invoice?                @relation("AcceptedInvoiceTransaction")
  reconciliationRun SePayReconciliationRun? @relation(fields: [reconciliationRunId], references: [id], onDelete: SetNull, map: "payment_transactions_reconciliation_run_fkey")

  @@unique([environment, gatewayTransactionId])
  @@unique([environment, sepayWebhookTransactionId], map: "payment_transactions_environment_webhook_id_key")
  @@unique([environment, sepayApiTransactionId], map: "payment_transactions_environment_api_id_key")
  @@index([bankReferenceKey])
  @@index([outcome, createdAt])
  @@index([environment, paymentTime])
  @@map("payment_transactions")
}

model SePayReconciliationRun {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  environment         String    @db.VarChar(10)
  trigger             String    @db.VarChar(20)
  status              String    @db.VarChar(20)
  requestedByUserId   String?   @map("requested_by_user_id") @db.Uuid
  rangeFrom           DateTime? @map("range_from") @db.Timestamptz()
  rangeTo             DateTime? @map("range_to") @db.Timestamptz()
  cursorBefore        String?   @map("cursor_before") @db.Uuid
  cursorAfter         String?   @map("cursor_after") @db.Uuid
  fetchedCount        Int       @default(0) @map("fetched_count")
  backfilledCount     Int       @default(0) @map("backfilled_count")
  linkedCount         Int       @default(0) @map("linked_count")
  matchedCount        Int       @default(0) @map("matched_count")
  reviewRequiredCount Int       @default(0) @map("review_required_count")
  ignoredCount        Int       @default(0) @map("ignored_count")
  localOnlyCount      Int       @default(0) @map("local_only_count")
  errors              Json      @default("[]") @db.JsonB
  startedAt           DateTime  @default(now()) @map("started_at") @db.Timestamptz()
  completedAt         DateTime? @map("completed_at") @db.Timestamptz()

  transactions PaymentTransaction[]

  @@index([environment, startedAt(sort: Desc)])
  @@map("sepay_reconciliation_runs")
}

model SePayReconciliationState {
  environment      String    @id @db.VarChar(10)
  cursor           String?   @db.Uuid
  lastSuccessfulAt DateTime? @map("last_successful_at") @db.Timestamptz()
  lastRunId        String?   @map("last_run_id") @db.Uuid
  lockedUntil      DateTime? @map("locked_until") @db.Timestamptz()
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("sepay_reconciliation_state")
}

model FacilitySettlement {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementCode       String             @unique @map("settlement_code") @db.VarChar(50)
  facilityId           String             @map("facility_id") @db.Uuid
  month                Int
  year                 Int
  totalRealizedRevenue Decimal            @map("total_realized_revenue") @db.Decimal(14, 2)
  platformFeeAmount    Decimal            @map("platform_fee_amount") @db.Decimal(14, 2)
  facilityPayoutAmount Decimal            @map("facility_payout_amount") @db.Decimal(14, 2)
  disbursementStatus   DisbursementStatus @default(PENDING) @map("disbursement_status")
  bankTransferOrderId  String?            @map("bank_transfer_order_id") @db.VarChar(100)
  transferMemo         String?            @map("transfer_memo") @db.VarChar(140)
  settledAt            DateTime?          @map("settled_at") @db.Timestamptz()
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz()

  environment         String                   @default("LIVE") @db.VarChar(10)
  bankDestination     Json                     @default("{}") @map("bank_destination") @db.JsonB
  failureReason       String?                  @map("failure_reason") @db.Text
  transferEvidenceKey String?                  @map("transfer_evidence_key") @db.Text
  confirmedByUserId   String?                  @map("confirmed_by_user_id") @db.Uuid
  reviewStatus        SettlementReviewStatus   @default(PENDING) @map("review_status")
  reviewVersion       Int                      @default(1) @map("review_version")
  reviewedAt          DateTime?                @map("reviewed_at") @db.Timestamptz()
