// Một hóa đơn chỉ xuất hiện trong một kỳ quyết toán, kể cả khi gọi lại API hoặc chạy lại job.
model FacilitySettlementItem {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settlementId        String             @map("settlement_id") @db.Uuid
  invoiceId           String             @map("invoice_id") @db.Uuid
  recognitionYear     Int?               @map("recognition_year")
  recognitionMonth    Int?               @map("recognition_month")
  recognitionBasis    String             @default("LEGACY_CASH") @map("recognition_basis") @db.VarChar(30)
  serviceFrom         DateTime?          @map("service_from") @db.Date
  serviceUntil        DateTime?          @map("service_until") @db.Date
  grossAmount         Decimal            @map("gross_amount") @db.Decimal(12, 2)
  vatAmount           Decimal            @map("vat_amount") @db.Decimal(12, 2)
  netAmount           Decimal            @map("net_amount") @db.Decimal(12, 2)
  platformFeeAmount   Decimal            @map("platform_fee_amount") @db.Decimal(12, 2)
  facilityShareAmount Decimal            @map("facility_share_amount") @db.Decimal(12, 2)
  settlement          FacilitySettlement @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  invoice             Invoice            @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@unique([invoiceId, recognitionYear, recognitionMonth], map: "settlement_invoice_period_unique")
  @@map("facility_settlement_items")
}

