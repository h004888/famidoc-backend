datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =========================================================================
// ENUMS (Ánh xạ các CHECK constraint trong SQL)
// =========================================================================

enum UserRole {
  ADMIN
  HEALTHCARE_FACILITY
  DOCTOR
  FAMILY_REP
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
}

enum FacilityVerificationStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum DoctorOnboardingStatus {
  PENDING_SUBMISSION
  PENDING_FACILITY_REVIEW
  FACILITY_VERIFIED
  ACTIVE
  SUSPENDED
}

enum DoctorCredentialType {
  PRACTICE_LICENSE_CCHN
  FAMILY_MEDICINE_CERT
  DEGREE
}

enum DoctorTreatedCaseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PlatformCareCategory {
  SERVICE_MODE
  COMMITMENT
}

enum ServicePackageStatus {
  DRAFT
  ACTIVE
  DEPRECATED
}

enum B2bContractStatus {
  PENDING_SIGNATURE
  PENDING_FACILITY_SIGNATURE
  REVISION_REQUESTED
  PENDING_ADMIN_SIGNATURE
  ACTIVE
  EXPIRED
  TERMINATED
}

enum FamilyUnitStatus {
  ACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum PatientStatus {
  ACTIVE
  INACTIVE
}

enum AllergenType {
  DRUG
  FOOD
  ENVIRONMENTAL
}

enum AllergySeverity {
  MILD
  MODERATE
  LIFE_THREATENING_ANAPHYLAXIS
}

enum ChronicClinicalStatus {
  ACTIVE
  CONTROLLED
  REMISSION
}

enum PatientDocumentType {
  LAB_RESULT
  IMAGING_XRAY_CT
  DISCHARGE_SUMMARY
  PRESCRIPTION
  OTHER
}

enum MedicalContractStatus {
  PENDING_APPROVAL
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum SignerRole {
  FAMILY_REP
  ADMIN
  HEALTHCARE_FACILITY
  ASSIGNED_DOCTOR
}

enum AddendumType {
  QUOTA_EXPANSION
  TERM_EXTENSION
  MEMBER_EXTENSION
}

enum AddendumStatus {
  PENDING_PAYMENT
  ACTIVE
  CANCELLED
}

enum EncounterType {
  HOME_VISIT
  TELEHEALTH
  FACILITY_VISIT
}

enum EncounterCategory {
  PERIODIC_ROUTINE
  AD_HOC_ON_DEMAND
}

enum EncounterVisitScope {
  FAMILY
  INDIVIDUAL
}

enum EncounterStatus {
  REQUESTED
  CONFIRMED
  ON_THE_WAY
  ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum RescheduleDecision {
  PENDING
  APPROVED
  REJECTED
}

enum RescheduleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PrescriptionStatus {
  ISSUED
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum DisbursementStatus {
  PENDING
  CONFIRMED
  SETTLED
  FAILED
}

enum SettlementReviewStatus {
  PENDING
  CONFIRMED
  DISPUTED
}

enum ComplaintStatus {
  SUBMITTED
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum OtpChallengePurpose {
  REGISTER_FAMILY_REP
  RESET_PASSWORD
}

enum DoctorClinicalTier {
  JUNIOR
  STANDARD
  SENIOR
}

enum QuotaProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchingSessionStatus {
  MATCHED
  QUEUED
  CONFIRMED
  EXPIRED
}

enum MatchingQueueStatus {
  QUEUED
  ASSIGNED
  CONFIRMED
  CANCELLED
  EXPIRED
}

// =========================================================================
// 1. PHÂN HỆ XÁC THỰC, NGƯỜI DÙNG & RBAC (FE-01, FE-03)
// =========================================================================

model User {
  id                  String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phone               String     @unique @db.VarChar(15)
  email               String     @unique @db.VarChar(150)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  role                UserRole
  fullName            String     @map("full_name") @db.VarChar(100)
  avatarUrl           String?    @map("avatar_url") @db.VarChar(255)
  status              UserStatus @default(PENDING)
  mustChangePassword  Boolean    @default(false) @map("must_change_password")
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz()
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  notifications                     Notification[]
  receivedPrescriptions             Prescription[]
  healthcareFacility                HealthcareFacility?
  doctor                            Doctor?
  familyUnit                        FamilyUnit?
  doctorCredentialsFacilityVerified DoctorCredential[]    @relation("FacilityVerifiedByUser")
  doctorCredentialsPlatformApproved DoctorCredential[]    @relation("PlatformApprovedByUser")
  contractSignatures                ContractSignature[]
  complainantComplaints             Complaint[]           @relation("ComplaintComplainantUser")
  targetComplaints                  Complaint[]           @relation("ComplaintTargetUser")
  systemConfigurationsUpdated       SystemConfiguration[]
  confirmedSettlements              FacilitySettlement[]  @relation("SettlementConfirmer")
  facilityComplaintResponses        Complaint[]           @relation("ComplaintFacilityReviewer")
  resolvedComplaints                Complaint[]           @relation("ComplaintResolver")
  auditLogs                         AuditLog[]
  approvedDoctorTreatedCases        DoctorTreatedCase[]   @relation("TreatedCaseApprover")
  requestedQuotaProposals           DoctorQuotaProposal[] @relation("QuotaProposalRequester")
  reviewedQuotaProposals            DoctorQuotaProposal[] @relation("QuotaProposalReviewer")
  matchingSessions                  MatchingSession[]
  matchingQueueRequests             MatchingQueueRequest[] @relation("QueueRequester")
  assignedQueueRequests             MatchingQueueRequest[] @relation("QueueAdminAssigner")
  authSessions                      AuthSession[]

  @@map("users")
}

model AuthSession {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  tokenHash           String    @unique @map("token_hash") @db.VarChar(64)
  familyId            String    @map("family_id") @db.Uuid
  rememberMe          Boolean   @default(false) @map("remember_me")
  clientIp            String?   @map("client_ip") @db.VarChar(45)
  userAgent           String?   @map("user_agent") @db.VarChar(255)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz()
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz()
  replacedBySessionId String?   @map("replaced_by_session_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt], map: "idx_auth_sessions_user_revoked")
  @@index([familyId], map: "idx_auth_sessions_family_id")
  @@index([expiresAt], map: "idx_auth_sessions_expires_at")
  @@map("auth_sessions")
}

model OtpChallenge {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  purpose       OtpChallengePurpose
  email         String              @db.VarChar(150)
  phone         String?             @db.VarChar(15)
  payload       Json?               @db.JsonB
  otpHash       String              @map("otp_hash") @db.VarChar(64)
  expiresAt     DateTime            @map("expires_at") @db.Timestamptz()
  cooldownUntil DateTime            @map("cooldown_until") @db.Timestamptz()
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(5) @map("max_attempts")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@unique([purpose, email], map: "otp_challenges_purpose_email_key")
  @@index([expiresAt], map: "otp_challenges_expires_at_idx")
  @@map("otp_challenges")
}

model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  title       String   @db.VarChar(200)
  content     String   @db.Text
  type        String   @db.VarChar(50)
  referenceId String?  @map("reference_id") @db.Uuid
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// =========================================================================
// 2. PHÂN HỆ CƠ SỞ Y TẾ & BÁC SĨ (FE-02, FE-06)
// =========================================================================

model HealthcareFacility {
  id                 String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String                     @unique @map("user_id") @db.Uuid
  facilityName       String                     @map("facility_name") @db.VarChar(255)
  licenseNumber      String                     @unique @map("license_number") @db.VarChar(50)
  taxCode            String                     @unique @map("tax_code") @db.VarChar(20)
  address            String                     @db.Text
  hotline            String                     @db.VarChar(15)
  bankName           String                     @map("bank_name") @db.VarChar(100)
  bankBin            String?                    @map("bank_bin") @db.VarChar(20)
  bankCode           String?                    @map("bank_code") @db.VarChar(20)
  bankAccountNumber  String                     @map("bank_account_number") @db.VarChar(50)
  bankAccountHolder  String                     @map("bank_account_holder") @db.VarChar(100)
  legalDocumentsUrl    String?                    @map("legal_documents_url") @db.Text
  legalDocumentKey     String?                    @map("legal_document_key") @db.Text
  businessLicenseKey   String?                    @map("business_license_key") @db.Text
  contactEmail         String?                    @map("contact_email") @db.VarChar(150)
  representativeName   String?                    @map("representative_name") @db.VarChar(100)
  licenseIssuer        String?                    @map("license_issuer") @db.VarChar(255)
  licenseDate          DateTime?                  @map("license_date") @db.Date
  legalRejectionReason String?                    @map("legal_rejection_reason") @db.Text
  verificationStatus   FacilityVerificationStatus @default(PENDING) @map("verification_status")
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user                User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  doctors             Doctor[]
  staffingContracts   B2bStaffingContract[]
  medicalContracts    MedicalContract[]
  facilitySettlements FacilitySettlement[]
  quotaProposals      DoctorQuotaProposal[]
  matchingSessions    MatchingSession[]
  assignedQueueItems  MatchingQueueRequest[] @relation("QueueAssignedFacility")

  @@map("healthcare_facilities")
}

model Doctor {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String                 @unique @map("user_id") @db.Uuid
  facilityId       String                 @map("facility_id") @db.Uuid
  doctorName       String                 @map("doctor_name") @db.VarChar(100)
  specialty        String                 @db.VarChar(100)
  academicTitle    String?                @map("academic_title") @db.VarChar(50)
  experienceYears  Int                    @map("experience_years")
  clinicalTier     DoctorClinicalTier     @default(STANDARD) @map("clinical_tier")
  bio              String?                @db.Text
  activePanelCount Int                    @default(0) @map("active_panel_count")
  maxPanelCapacity Int                    @default(5) @map("max_panel_capacity")
  ratingAvg              Decimal                @default(5.00) @map("rating_avg") @db.Decimal(3, 2)
  totalReviews           Int                    @default(0) @map("total_reviews")
  onboardingStatus       DoctorOnboardingStatus @default(PENDING_SUBMISSION) @map("onboarding_status")
  rejectionReason        String?                @map("rejection_reason") @db.Text
  credentialsSubmittedAt DateTime?              @map("credentials_submitted_at") @db.Timestamptz()
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  user               User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  facility           HealthcareFacility     @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  credentials        DoctorCredential[]
  medicalContracts   MedicalContract[]
  encounters         Encounter[]
  reviews            DoctorReview[]
  treatedCases       DoctorTreatedCase[]
  quotaProposals     DoctorQuotaProposal[]
  matchingSessions   MatchingSession[]
  assignedQueueItems MatchingQueueRequest[] @relation("QueueAssignedDoctor")

  @@index([clinicalTier, onboardingStatus], map: "idx_doctors_tier_status")
  @@map("doctors")
}

model DoctorCredential {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorId           String               @map("doctor_id") @db.Uuid
  credentialType     DoctorCredentialType @map("credential_type")
  certificateNumber  String               @map("certificate_number") @db.VarChar(100)
  issueDate          DateTime             @map("issue_date") @db.Date
  issuingAuthority   String               @map("issuing_authority") @db.VarChar(200)
  fileUrl            String               @map("file_url") @db.VarChar(255)
  fileKey            String?              @map("file_key") @db.Text
  facilityVerified   Boolean              @default(false) @map("facility_verified")
  facilityVerifiedBy String?              @map("facility_verified_by") @db.Uuid
  facilityVerifiedAt DateTime?            @map("facility_verified_at") @db.Timestamptz()
  platformApproved   Boolean              @default(false) @map("platform_approved")
  platformApprovedBy String?              @map("platform_approved_by") @db.Uuid
  platformApprovedAt DateTime?            @map("platform_approved_at") @db.Timestamptz()
  rejectionReason    String?              @map("rejection_reason") @db.Text

  // Relations
  doctor           Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facilityVerifier User?  @relation("FacilityVerifiedByUser", fields: [facilityVerifiedBy], references: [id])
  platformApprover User?  @relation("PlatformApprovedByUser", fields: [platformApprovedBy], references: [id])

  @@map("doctor_credentials")
}

model DoctorTreatedCase {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorId        String                  @map("doctor_id") @db.Uuid
  summary         String                  @db.Text
  status          DoctorTreatedCaseStatus @default(PENDING)
  rejectionReason String?                 @map("rejection_reason") @db.Text
  approvedBy      String?                 @map("approved_by") @db.Uuid
  approvedAt      DateTime?               @map("approved_at") @db.Timestamptz()
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  doctor   Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  approver User?  @relation("TreatedCaseApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([doctorId, status], map: "idx_doctor_treated_cases_lookup")
  @@map("doctor_treated_cases")
}

// =========================================================================
// 3. PHÂN HỆ GÓI DỊCH VỤ & HỢP ĐỒNG PHÁP LÝ (FE-04, FE-05)
// =========================================================================

model ServicePackage {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  packageCode         String               @unique @map("package_code") @db.VarChar(50)
  packageName         String               @map("package_name") @db.VarChar(150)
  durationMonths      Int                  @map("duration_months")
  basePrice           Decimal              @map("base_price") @db.Decimal(12, 2)
  periodicVisitsQuota Int                  @map("periodic_visits_quota")
  telehealthQuota     Int                  @map("telehealth_quota")
  videoQuotaPolicy    String               @default("FIXED") @map("video_quota_policy") @db.VarChar(20)
  homeVisitUnitPrice  Decimal?             @map("home_visit_unit_price") @db.Decimal(12, 2)
  maxMembers          Int                  @default(6) @map("max_members")
  status              ServicePackageStatus @default(ACTIVE)
  deletedAt           DateTime?            @map("deleted_at") @db.Timestamptz()
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt           DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Bổ sung điều khoản từ bảng giá. Mỗi phiên bản là một bản ghi riêng để giữ lịch sử.
  lineageCode                  String    @map("lineage_code") @db.VarChar(50)
  version                      Int       @default(1)
  description                  String    @default("") @db.Text
  includedMembers              Int       @default(1) @map("included_members")
  additionalMemberMonthlyPrice Decimal   @default(0) @map("additional_member_monthly_price") @db.Decimal(12, 2)
  quotaPeriod                  String    @default("PER_TERM") @map("quota_period") @db.VarChar(20)
  publishedAt                  DateTime? @map("published_at") @db.Timestamptz()
  retiredAt                    DateTime? @map("retired_at") @db.Timestamptz()

  // Relations
  medicalContracts      MedicalContract[]
  matchingSessions      MatchingSession[]
  matchingQueueRequests MatchingQueueRequest[]

  @@unique([lineageCode, version])
  @@map("service_packages")
}

model PlatformCareItem {
  id          String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category    PlatformCareCategory
  title       String               @db.VarChar(150)
  description String               @default("") @db.Text
  icon        String?              @db.VarChar(50)
  sortOrder   Int                  @default(0) @map("sort_order")
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  @@index([category, isActive, sortOrder], map: "idx_platform_care_items_order")
  @@map("platform_care_items")
}

model B2bStaffingContract {
  id                           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contractCode                 String            @unique @map("contract_code") @db.VarChar(50)
  facilityId                   String            @map("facility_id") @db.Uuid
  platformCommissionRate       Decimal           @default(15.00) @map("platform_commission_rate") @db.Decimal(5, 2)
  facilityRevenueRate          Decimal           @default(85.00) @map("facility_revenue_rate") @db.Decimal(5, 2)
  startDate                    DateTime          @map("start_date") @db.Date
  endDate                      DateTime          @map("end_date") @db.Date
  signedPdfUrl                 String?           @map("signed_pdf_url") @db.VarChar(255)
  signedPdfKey                 String?           @map("signed_pdf_key") @db.Text
  contractTerms                String?           @map("contract_terms") @db.Text
  revisionReason               String?           @map("revision_reason") @db.Text
  documensoEnvelopeId          String?           @unique @map("documenso_envelope_id") @db.VarChar(100)
  documensoItemId              String?           @map("documenso_item_id") @db.VarChar(100)
  facilityDocumensoRecipientId Int?              @map("facility_documenso_recipient_id")
  facilitySigningUrl           String?           @map("facility_signing_url") @db.Text
  facilitySigningToken         String?           @map("facility_signing_token") @db.VarChar(128)
  adminDocumensoRecipientId    Int?              @map("admin_documenso_recipient_id")
  adminSigningUrl              String?           @map("admin_signing_url") @db.Text
  adminSigningToken            String?           @map("admin_signing_token") @db.VarChar(128)
  facilitySignedAt             DateTime?         @map("facility_signed_at") @db.Timestamptz()
  adminSignedAt                DateTime?         @map("admin_signed_at") @db.Timestamptz()
  terminationRequestStatus     String?           @map("termination_request_status") @db.VarChar(32)
  terminationRequestReason     String?           @map("termination_request_reason") @db.Text
  terminationRequestedAt       DateTime?         @map("termination_requested_at") @db.Timestamptz()
  terminatedReason             String?           @map("terminated_reason") @db.Text
  terminatedAt                 DateTime?         @map("terminated_at") @db.Timestamptz()
  terminatedByUserId           String?           @map("terminated_by_user_id") @db.Uuid
  status                       B2bContractStatus @default(PENDING_FACILITY_SIGNATURE)
  createdAt                    DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt                    DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  facility HealthcareFacility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@map("b2b_staffing_contracts")
}

// =========================================================================
// 4. PHÂN HỆ HỘ GIA ĐÌNH & HỒ SƠ BỆNH ÁN DỌC (FE-07)
// =========================================================================

model FamilyUnit {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  representativeUserId String           @unique @map("representative_user_id") @db.Uuid
  homeAddress          String           @map("home_address") @db.Text
  emergencyPhone       String           @map("emergency_phone") @db.VarChar(15)
  status               FamilyUnitStatus @default(ACTIVE)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  representativeUser    User                   @relation(fields: [representativeUserId], references: [id], onDelete: Restrict)
  patients              Patient[]
  medicalContracts      MedicalContract[]
  doctorReviews         DoctorReview[]
  matchingSessions      MatchingSession[]
  matchingQueueRequests MatchingQueueRequest[]

  @@map("family_units")
}

model Patient {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId              String        @map("family_id") @db.Uuid
  fullName              String        @map("full_name") @db.VarChar(100)
  dateOfBirth           DateTime      @map("date_of_birth") @db.Date
  gender                Gender
  relationshipToHead String        @map("relationship_to_head") @db.VarChar(50)
  bloodType          String?       @map("blood_type") @db.VarChar(10)
  heightCm           Decimal?      @map("height_cm") @db.Decimal(5, 1)
  weightKg           Decimal?      @map("weight_kg") @db.Decimal(5, 1)
  chronicDiseases    String?       @map("chronic_diseases") @db.Text
  status                PatientStatus @default(ACTIVE)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt             DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  familyUnit      FamilyUnit        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  allergies             PatientAllergy[]
  chronicConditions     PatientChronicCondition[]
  documents             PatientDocument[]
  encounterParticipants EncounterParticipant[]
  clinicalEmrs          ClinicalEmr[]
  vitalSigns            VitalSign[]
  contractMembers       ContractMember[]

  @@map("patients")
}

model PatientAllergy {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId             String          @map("patient_id") @db.Uuid
  allergenType          AllergenType    @map("allergen_type")
  allergenName          String          @map("allergen_name") @db.VarChar(150)
  severity              AllergySeverity
  clinicalManifestation String?         @map("clinical_manifestation") @db.Text
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_allergies")
}

model PatientChronicCondition {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patientId      String                @map("patient_id") @db.Uuid
  conditionName  String                @map("condition_name") @db.VarChar(150)
  icd10Code      String?               @map("icd10_code") @db.VarChar(20)
  clinicalStatus ChronicClinicalStatus @default(ACTIVE) @map("clinical_status")
  diagnosedAt    DateTime?             @map("diagnosed_at") @db.Date
  notes          String?               @db.Text
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz()
