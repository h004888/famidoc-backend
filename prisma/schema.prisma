model DoctorQuotaProposal {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctorId          String              @map("doctor_id") @db.Uuid
  facilityId        String              @map("facility_id") @db.Uuid
  requestedByUserId String              @map("requested_by_user_id") @db.Uuid
  currentMaxPanel   Int                 @map("current_max_panel")
  requestedMaxPanel Int                 @map("requested_max_panel")
  reason            String              @db.Text
  status            QuotaProposalStatus @default(PENDING)
  reviewedByUserId  String?             @map("reviewed_by_user_id") @db.Uuid
  reviewedAt        DateTime?           @map("reviewed_at") @db.Timestamptz()
  reviewNote        String?             @map("review_note") @db.Text
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  doctor          Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facility        HealthcareFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  requestedByUser User               @relation("QuotaProposalRequester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedByUser  User?              @relation("QuotaProposalReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([doctorId, status], map: "idx_doctor_quota_proposals_doctor_status")
  @@index([facilityId, status], map: "idx_doctor_quota_proposals_facility_status")
  @@index([status, createdAt], map: "idx_doctor_quota_proposals_status_created")
  @@map("doctor_quota_proposals")
}

model MatchingSession {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String?               @map("user_id") @db.Uuid
  familyId             String?               @map("family_id") @db.Uuid
  packageId            String                @map("package_id") @db.Uuid
  memberCount          Int                   @map("member_count")
  requestedTier        DoctorClinicalTier?   @map("requested_tier")
  ageGroups            Json                  @default("[]") @map("age_groups") @db.JsonB
  careCategories       Json                  @default("[]") @map("care_categories") @db.JsonB
  districtArea         String?               @map("district_area") @db.VarChar(120)
  sanitizedDescription String?               @map("sanitized_description") @db.Text
  matchedDoctorId      String?               @map("matched_doctor_id") @db.Uuid
  inferredFacilityId   String?               @map("inferred_facility_id") @db.Uuid
  jevModelVersion      String?               @map("jev_model_version") @db.VarChar(50)
  jevFitScore          Decimal?              @map("jev_fit_score") @db.Decimal(5, 4)
  vacancyScore         Decimal?              @map("vacancy_score") @db.Decimal(5, 4)
  compositeScore       Decimal?              @map("composite_score") @db.Decimal(5, 4)
  rationale            String?               @db.Text
  candidateSnapshots   Json?                 @map("candidate_snapshots") @db.JsonB
  status               MatchingSessionStatus @default(MATCHED)
  contractId           String?               @unique @map("contract_id") @db.Uuid
  expiresAt            DateTime              @map("expires_at") @db.Timestamptz()
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  familyUnit       FamilyUnit?           @relation(fields: [familyId], references: [id], onDelete: SetNull)
  servicePackage   ServicePackage        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  matchedDoctor    Doctor?               @relation(fields: [matchedDoctorId], references: [id], onDelete: SetNull)
  inferredFacility HealthcareFacility?   @relation(fields: [inferredFacilityId], references: [id], onDelete: SetNull)
  contract         MedicalContract?      @relation(fields: [contractId], references: [id], onDelete: SetNull)
  queueRequest     MatchingQueueRequest?

  @@index([userId, createdAt], map: "idx_matching_sessions_user_created")
  @@index([status, expiresAt], map: "idx_matching_sessions_status_expires")
  @@map("matching_sessions")
}

model MatchingQueueRequest {
  id                   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchingSessionId    String?             @unique @map("matching_session_id") @db.Uuid
  userId               String?             @map("user_id") @db.Uuid
  familyId             String?             @map("family_id") @db.Uuid
  packageId            String              @map("package_id") @db.Uuid
  memberCount          Int                 @map("member_count")
  requestedTier        DoctorClinicalTier? @map("requested_tier")
  ageGroups            Json                @default("[]") @map("age_groups") @db.JsonB
  careCategories       Json                @default("[]") @map("care_categories") @db.JsonB
  districtArea         String?             @map("district_area") @db.VarChar(120)
  sanitizedDescription String?             @map("sanitized_description") @db.Text
  fallbackReason       String              @map("fallback_reason") @db.VarChar(100)
  status               MatchingQueueStatus @default(QUEUED)
  slaExpiresAt         DateTime            @map("sla_expires_at") @db.Timestamptz()
  assignedDoctorId     String?             @map("assigned_doctor_id") @db.Uuid
  assignedFacilityId   String?             @map("assigned_facility_id") @db.Uuid
  assignedByUserId     String?             @map("assigned_by_user_id") @db.Uuid
  assignedAt           DateTime?           @map("assigned_at") @db.Timestamptz()
  adminNote            String?             @map("admin_note") @db.Text
  contractId           String?             @unique @map("contract_id") @db.Uuid
  cancelledAt          DateTime?           @map("cancelled_at") @db.Timestamptz()
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()

  matchingSession  MatchingSession?    @relation(fields: [matchingSessionId], references: [id], onDelete: SetNull)
  user             User?               @relation("QueueRequester", fields: [userId], references: [id], onDelete: SetNull)
  familyUnit       FamilyUnit?         @relation(fields: [familyId], references: [id], onDelete: SetNull)
  servicePackage   ServicePackage      @relation(fields: [packageId], references: [id], onDelete: Restrict)
  assignedDoctor   Doctor?             @relation("QueueAssignedDoctor", fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  assignedFacility HealthcareFacility? @relation("QueueAssignedFacility", fields: [assignedFacilityId], references: [id], onDelete: SetNull)
  assignedByUser   User?               @relation("QueueAdminAssigner", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  contract         MedicalContract?    @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([status, slaExpiresAt], map: "idx_matching_queue_status_sla")
  @@index([familyId, status], map: "idx_matching_queue_family_status")
  @@index([userId, status], map: "idx_matching_queue_user_status")
  @@map("matching_queue_requests")
}
